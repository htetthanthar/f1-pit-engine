# The dashboard image: small, no training libraries, runs as a non-root user.
#   docker build -f Dockerfile.dashboard -t f1pit-dashboard .
#   docker run --rm -p 8501:8501 f1pit-dashboard        -> http://localhost:8501
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv

COPY app/requirements.txt app/requirements.txt
RUN pip install --no-cache-dir -r app/requirements.txt

COPY .streamlit ./.streamlit
COPY src/f1pit/__init__.py src/f1pit/dashboard.py ./src/f1pit/
COPY app ./app

RUN useradd --create-home --uid 1000 appuser && chown -R appuser /srv
USER appuser

EXPOSE 8501
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=4)"

CMD ["streamlit", "run", "app/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
